#!/bin/sh
# Runs codex-jev with Jev pruning enabled. Symlink into PATH.
# Uses the installed build (~/.local/share/codex-jev/current), else this checkout's release build.
root="$(dirname "$(readlink -f "$0")")/.."
bin="${XDG_DATA_HOME:-$HOME/.local/share}/codex-jev/current/codex"
[ -x "$bin" ] || bin="$root/codex-rs/target/release/codex"
CODEX_JEV_COMPACT="$root/jev/codex-jev-compact.ts" exec "$bin" "$@"
